# ContractSentinel Environment Variables

# Ollama Configuration
# OLLAMA_HOST is read by the ollama client for embeddings (bge-m3) — and, when LLM_PROVIDER=ollama,
# for generation too. In Docker, 127.0.0.1 is NOT the VM host: use --network host, or set this to
# http://host.docker.internal:11434 (with --add-host=host.docker.internal:host-gateway).
OLLAMA_HOST=http://localhost:11434
# NOTE: the embedding model is fixed at bge-m3 in code (OLLAMA_EMBED_MODEL_NAME, not env-overridable) —
# no env var needed; just `ollama pull bge-m3` on the host.

# ── Groq generation (LLM provider adapter — feature 046) ─────────────────────────
# Free API key from https://console.groq.com. When LLM_PROVIDER=groq the 5 generative LLM calls route
# to Groq while embeddings stay on local Ollama/bge-m3 (never sent to Groq). Default "ollama" = fully
# local, no egress. In your real, gitignored backend/.env set (no quotes, no spaces around '='):
# LLM_PROVIDER=groq                     # "ollama" (default, local) | "groq" (deploy)
# GROQ_API_KEY=gsk_your_key_here        # NEVER commit this
# GROQ_MODEL=openai/gpt-oss-120b        # Groq catalog model (NOT llama-3.3-70b — not offered)
# NOTE: Groq free tier caps ~200,000 tokens/day — a few full analyses. Beyond that → degraded reports.

# Database Configuration
DATABASE_URL=sqlite:///./contractsentinel.db

# MCP Configuration
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id
GMAIL_SENDER_EMAIL=your_email@gmail.com

# API Configuration
API_HOST=localhost
API_PORT=8000

# Thresholds (Configurable constants)
CRAG_CONFIDENCE_THRESHOLD=0.73
MAX_RETRY_ATTEMPTS=3

# ── Security hardening Tier 1 (feature 032) ─────────────────────────────────────
# Encryption at rest for OAuth tokens. If unset, a Fernet key is generated + persisted
# to data/encryption_key (0600) on first run. Back this up: losing it orphans stored
# Google tokens (users simply re-connect). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CONTRACTSENTINEL_ENCRYPTION_KEY=

# Session/cookie hardening. AUTH_COOKIE_SECURE defaults to True and REQUIRES TLS in
# front of the app (browsers drop a Secure cookie over plain HTTP). For LOCAL
# plaintext-HTTP dev you MUST set this to False or login will appear to silently fail:
# AUTH_COOKIE_SECURE=False
# AUTH_SESSION_TTL_SECONDS=28800      # absolute cap, default 8h
# AUTH_IDLE_TIMEOUT_SECONDS=1800      # sliding idle logout, default 30m

# ── Cross-origin deploy (feature 048) ───────────────────────────────────────────
# Only needed when the frontend and backend are on DIFFERENT origins (e.g. Vercel + a VM).
# CORS_ALLOWED_ORIGINS: comma-separated exact frontend origin(s). Unset ⇒ localhost dev default.
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# AUTH_COOKIE_SAMESITE: "none" lets the session cookie cross a site boundary (Vercel↔VM); it REQUIRES
# AUTH_COOKIE_SECURE=True (the app refuses to boot otherwise). Default "lax" is right when frontend +
# backend share a registrable domain (e.g. app. + api.yourdomain.com) — then leave this unset.
# AUTH_COOKIE_SAMESITE=none
#
# Google OAuth prod URLs (feature 049) — only if you use Drive/Gmail delivery:
# GOOGLE_OAUTH_REDIRECT_URI must EXACTLY match the URI registered on the GCP Web OAuth client.
# FRONTEND_INTEGRATIONS_URL is where the backend 302-redirects the browser after connect/disconnect.
# GOOGLE_OAUTH_REDIRECT_URI=https://api.yourdomain.com/api/integrations/google/callback
# FRONTEND_INTEGRATIONS_URL=https://your-app.vercel.app/integrations

# Login rate-limiting / account lockout (defaults shown).
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# AUTH_LOCKOUT_MAX_FAILURES=5
# AUTH_LOCKOUT_WINDOW_SECONDS=900
# AUTH_LOCKOUT_DURATION_SECONDS=900