# ContractSentinel frontend — environment template. Copy to .env.local for dev, or set these
# in the Vercel/Cloudflare Pages project settings for prod. See docs/DEPLOYMENT.md §5.
# Only NEXT_PUBLIC_* vars are exposed to the browser — never put secrets here.

# "real" = talk to the live backend API; "mock" = in-browser fixtures (no backend).
NEXT_PUBLIC_API_PROVIDER=real

# Backend base URL.
#  - Local dev: leave blank to use the Next dev proxy (same-origin).
#  - Prod: the backend's public HTTPS origin, e.g. https://api.yourdomain.com
#    (this origin must be listed in the backend's CORS_ALLOWED_ORIGINS — feature 048).
NEXT_PUBLIC_API_BASE_URL=
